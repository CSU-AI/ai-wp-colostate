  "narrative": {
    "northStar": "The Campus Field Guide",
    "overview": "The site is a practical field guide for the CSU community. Each page names a task, points to the answer, and gets out of the way.",
    "keyCharacteristics": [
      "Flat and bordered: a 6px green top edge and a 1px outline replace shadows.",
      "Dark text on light surfaces only.",
      "One H1 per page, ordered headings, Title Case headings and buttons.",
      "Icons and diagrams, never photo-realistic AI imagery.",
      "Only brand-approved color pairings; status never relies on color alone."
    ],
    "rules": [
      {
        "name": "The Approved Pairing Rule",
        "body": "If a background/text pair is not on the brand list, do not use it.",
        "section": "colors"
      },
      {
        "name": "The Words-First Status Rule",
        "body": "Approval or risk is stated in text; color is a second cue, never the only one.",
        "section": "colors"
      },
      {
        "name": "The Inherit-It Rule",
        "body": "Do not set paragraph size or color per widget; the theme ignores it.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces carry no shadow. Use the callout tint and edge instead.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do build with native Elementor containers and widgets.",
      "Do state status and data limits in words.",
      "Do keep dark text on light backgrounds and use only approved pairings.",
      "Do use real CSU photography, icons, or diagrams.",
      "Do use Title Case for headings and buttons, sentence case for body, and no em dashes."
    ],
    "donts": [
      "Don't set white or custom paragraph text on dark backgrounds.",
      "Don't recolor theme buttons or rely on paragraph font-size settings.",
      "Don't add shadows, gradients, or decorative effects.",
      "Don't use AI-generated photo-realistic imagery.",
      "Don't nest menus beyond two levels or use HTML widgets and custom code in pushed pages."
